# ==========================================================================
# GMall BE — Environment variables template
# --------------------------------------------------------------------------
# Copy file này thành `.env` (không commit `.env`) rồi điền giá trị thật.
# Các env có dấu (*) là BẮT BUỘC — thiếu sẽ làm app không boot
# (xem src/common/config/env.validation.ts).
# ==========================================================================

# --- Runtime ---
# Wiki 0042: Trên prod BẮT BUỘC = production. Ảnh hưởng:
#   - Cookie auth: production → SameSite=None+Secure (cross-site work),
#     development → SameSite=Lax (cross-site fetch không gửi cookie → login loop).
#   - Logger verbosity, error stack trace exposure, nhiều behavior khác.
NODE_ENV=development
PORT=3001

# --- Database (*) ---
# Format: mysql://user:password@host:3306/dbname
DATABASE_URL=mysql://root:password@localhost:3306/gmall?connection_limit=50&pool_timeout=20

# --- JWT (*) ---
# JWT_SECRET phải >= 16 ký tự. Tạo nhanh:
#   openssl rand -hex 32
# TUYỆT ĐỐI KHÔNG dùng lại secret cũ hoặc giá trị ví dụ ở prod.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-16-chars
JWT_EXPIRATION_TIME=7d

# --- Redis (*) ---
# Redis là bắt buộc: dùng cho BullMQ queue, Socket.io adapter, OTP store.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- CORS ---
# Whitelist cho Frontend gọi API. Comma-separated. KHÔNG dùng `*` kèm
# credentials:true (lỗ hổng CSRF). Xem docs/wiki/decisions/0004-cors-whitelist.md
# QUAN TRỌNG (wiki 0040): Trên prod PHẢI thêm domain FE production. Thiếu →
# tất cả request cross-origin từ FE đều bị BE callback throw 500. Triệu chứng:
# trang detail hiện "Không tìm thấy sản phẩm" dù BE trả 200 khi curl trực tiếp.
# Format prod ví dụ: CORS_ORIGINS=https://gmall.onrender.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Frontend URL ---
# Base URL của FE, dùng để build link trong email (reset password...).
# Prod phải set đúng domain public; dev fallback về localhost nếu thiếu.
FE_URL=http://localhost:3000

# --- Mail SMTP (tùy chọn nhưng thiếu sẽ không gửi OTP/thông báo) ---
MAIL_HOST=smtp.gmail.com
MAIL_USER=
MAIL_PASS=

# --- AWS S3 / Cloudflare R2 (tùy chọn, bật khi dùng storage module) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# --- OAuth (tùy chọn, bật khi muốn Login with Google/Facebook) ---
# Tạo credentials tại:
#   Google: https://console.cloud.google.com/apis/credentials
#           Authorized redirect URI = giá trị GOOGLE_CALLBACK_URL bên dưới
#   Facebook: https://developers.facebook.com/apps (app type: Consumer)
#             Valid OAuth Redirect URIs = giá trị FACEBOOK_CALLBACK_URL bên dưới
# Thiếu set thì /auth/google và /auth/facebook sẽ trả 503 (không làm vỡ app).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# --- Third-party (tùy chọn) ---
OPENAI_API_KEY=
GHN_TOKEN=
PAY2S_API_KEY=

# --- Chat encryption (tùy chọn) ---
# 32 ký tự cho AES-256. Thiếu sẽ fallback default (KHÔNG an toàn cho prod).
CHAT_ENCRYPTION_KEY=

# --- Image search (wiki 0052) ---
# Thiếu sẽ fallback localhost. Trên prod nhớ set đúng theo deploy.
CLIP_SERVICE_URL=http://localhost:8000
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=products
QDRANT_API_KEY=
