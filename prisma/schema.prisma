generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // Có thể đổi thành "postgresql" nếu muốn dùng JSONB mạnh mẽ hơn
  url      = env("DATABASE_URL")
}

// --------------------------------------
// ENUMS
// --------------------------------------

enum Role {
  BUYER
  SELLER
  PENDING_SELLER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

// --------------------------------------
// MODELS
// --------------------------------------

enum FriendshipStatus {
  PENDING // Đang chờ chấp nhận
  ACCEPTED // Đã là bạn bè
  BLOCKED // Đã chặn
}

model Friendship {
  id         String           @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Quan hệ tới User
  sender   User @relation("FriendshipSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

enum ShopStatus {
  ACTIVE
  PENDING
  BANNED
  REJECTED
  VACATION // Chế độ nghỉ lễ
}

model User {
  id         String  @id @default(uuid())
  email      String? @unique // Đổi thành Optional (có thể null nếu dùng username)
  password   String? // Dành cho local auth
  username   String? @unique // Thêm trường Username
  isVerified Boolean @default(false)

  // Spec [0018]: đổi password -> bump tokenVersion để invalidate JWT cũ
  // (logout tất cả thiết bị khác). JWT issued trước có version cũ -> JwtStrategy
  // reject. Default 0 cho user hiện có.
  tokenVersion Int @default(0)

  // Referral: ai đã giới thiệu user này (nullable). Khi user đặt đơn đầu ≥ 300k,
  // BE bump điểm cho referrer. Self-relation tới User.id.
  referredById        String?
  referredBy          User?               @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           User[]              @relation("UserReferrals")
  referralRewardPaid  Boolean             @default(false) // Đã trả thưởng chưa (1 lần duy nhất khi đơn đầu hợp lệ)
  name                String?
  phone               String?
  avatar              String?
  gender              String? // 'male' | 'female' | 'other' — free-form string, không enum để dễ mở rộng
  dob                 DateTime? // Ngày sinh (date-only đủ nhưng Prisma MySQL lưu DateTime)
  role                Role                @default(BUYER)
  sentFriendships     Friendship[]        @relation("FriendshipSender")
  receivedFriendships Friendship[]        @relation("FriendshipReceiver")
  isBanned            Boolean             @default(false)
  banReason           String? // Lý do bị khóa
  walletBalance       Decimal             @default(0) @db.Decimal(15, 2)
  payoutRequests      PayoutRequest[]
  walletTransactions  WalletTransaction[]
  blogPosts           BlogPost[]
  shopId              String?
  shop                Shop?
  reviews             ProductReview[]
  shopReviews         ShopReview[]
  createdVouchers     Voucher[]           @relation("SellerVouchers") // Voucher do Seller này tạo
  savedVouchers       UserVoucher[]

  points            Int                @default(0) // Số dư hiện tại (snapshot để query nhanh)
  pointTransactions PointTransaction[] // Quan hệ 1-n
  lastCheckIn       DateTime? // Thời gian lần cuối điểm danh
  checkInStreak     Int                @default(0) // Chuỗi ngày điểm danh liên tiếp
  pointWallet       PointWallet?
  pointHistory      PointHistory[]
  dailyCheckIn      DailyCheckIn?

  // Quan hệ
  cart      Cart?
  orders    Order[]
  products  Product[] // Sản phẩm do seller đăng bán
  addresses Address[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[] @relation("UserConversations")
  messages      Message[]

  shopName      String? @unique // Tên shop (cần Unique để không trùng)
  pickupAddress String? // Địa chỉ lấy hàng
  description   String? // Mô tả shop
  coverImage    String? // Ảnh bìa shop

  // Charity / Donation (xem model CharityFund, Donation ở cuối file)
  donations Donation[]

  // #65 — khiếu nại do user/seller gửi (xem model Complaint cuối file).
  complaints Complaint[]

  // #11/#23/#35/#53 (wiki 0044/0045) — thông báo cá nhân (notification model cuối file).
  notifications Notification[]

  // wiki 0105 — tài khoản tiếp thị (affiliate SẢN PHẨM). Khác hẳn `referredById` ở trên:
  // referral gắn vào NGƯỜI (1-1 vĩnh viễn, thưởng 1 lần), affiliate gắn vào GIAO DỊCH
  // (link → click → dòng hàng → hoa hồng, lặp vô hạn). Hai hệ chạy song song.
  affiliateAccount AffiliateAccount?

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model SystemSetting {
  key         String   @id // Ví dụ: "POINT_CONVERSION_RATE"
  value       String // Ví dụ: "10000"
  description String?
  updatedAt   DateTime @updatedAt
}

model ProductReview {
  id      String  @id @default(uuid())
  content String? @db.Text
  rating  Int     @default(5) // 1-5 sao
  images  Json? // Mảng URL ảnh đánh giá

  userId String
  user   User   @relation(fields: [userId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([rating])
}

model ShopReview {
  id      String  @id @default(uuid())
  content String? @db.Text
  rating  Int     @default(5)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  orderId String @unique // <--- QUAN TRỌNG: Thêm @unique để sửa lỗi
  order   Order  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
}

model Shop {
  id            String       @id @default(uuid())
  name          String // Tên hiển thị của Shop
  slug          String       @unique // Đường dẫn định danh (vd: shopee.vn/ten-shop)
  description   String?      @db.Text
  avatar        String? // Logo Shop
  coverImage    String? // Ảnh bìa Shop
  pickupAddress String? // Địa chỉ kho lấy hàng
  provinceId    Int?
  districtId    Int?
  wardCode      String?
  lat           Float?       @default(0)
  lng           Float?       @default(0)
  categoryId    String? // ID Ngành hàng chủ lực (để Optional vì shop cũ có thể chưa có)
  category      Category?    @relation("ShopMainCategory", fields: [categoryId], references: [id])
  status        ShopStatus   @default(PENDING)
  orders        Order[]
  banReason     String?
  reviews       ShopReview[]
  reviewCount   Int          @default(0)

  // --- Cấu hình giao diện (Shop Decoration) ---
  // Lưu JSON cấu trúc trang trí (Banner slider, Featured Products, Video...)
  decoration     Json?          @default("{}")
  shopCategories ShopCategory[]
  pendingDetails Json?

  // --- Đánh giá ---
  rating     Float @default(0)
  totalSales Int   @default(0) // Tổng sản phẩm đã bán

  // Quan hệ Owner
  ownerId      String  @unique // Hiện tại 1 User - 1 Shop
  owner        User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  address      String? // Nơi lưu pickupAddress
  licenseImage String? // Nơi lưu ảnh giấy phép
  taxCode      String? // Mã số thuế
  businessType String? // Wiki 0094: 'personal' | 'company' — seller chọn ở form đăng ký

  businessLicenseFront String? // ĐKKD mặt trước
  businessLicenseBack  String? // ĐKKD mặt sau
  salesLicense         String? // Giấy phép bán hàng
  trademarkCert        String? // Đăng ký nhãn hiệu
  distributorCert      String? // Chứng nhận đại lý/phân phối

  // Quan hệ tài nguyên
  products Product[]
  vouchers Voucher[] @relation("ShopVouchers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([status])
  @@index([categoryId])
}

// Ví điểm (Tách riêng để dễ lock row khi giao dịch)
model PointWallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0) // Số dư hiện tại
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// Lịch sử biến động (Ledger)
model PointHistory {
  id          String   @id @default(uuid())
  userId      String
  amount      Int // Số dương là nhận, âm là tiêu
  type        String // EARN, SPEND
  source      String // CHECKIN, GACHA, ORDER, ADMIN_ADJUST
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Trạng thái điểm danh
model DailyCheckIn {
  id              String   @id @default(uuid())
  userId          String   @unique
  lastCheckInDate DateTime // Ngày điểm danh gần nhất
  currentStreak   Int      @default(0) // Chuỗi hiện tại

  user User @relation(fields: [userId], references: [id])
}

enum PointType {
  EARN_ORDER
  EARN_DAILY // <--- Đã có (Dùng cho điểm danh)
  EARN_GAME
  EARN_AFFILIATE
  SPEND_ORDER
  SPEND_GAME
  REFUND
  EARN_TASK // Nhận từ làm nhiệm vụ
  TRANSFER_SENT // Chuyển xu đi
  TRANSFER_RECEIVED // Nhận xu từ người khác
}

model PointTransaction {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  amount       Int // Số dương (+) hoặc âm (-)
  type         PointType
  balanceAfter Int // Số dư sau khi thực hiện (Snapshot)
  referenceId  String? // ID tham chiếu (ví dụ: ngày điểm danh "DAILY_2024-01-01")
  description  String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([referenceId])
}

model Conversation {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now()) // Để sắp xếp hội thoại

  // Quan hệ
  participants User[]    @relation("UserConversations") // Many-to-Many với User
  messages     Message[]
}

// 3. Thêm model Message (Tin nhắn)
model Message {
  id        String      @id @default(uuid())
  content   String      @db.Text // Wiki 0083: TEXT (was VARCHAR191) — tin nhắn dài không fail lưu
  type      MessageType @default(TEXT)
  isRead    Boolean     @default(false)
  createdAt DateTime    @default(now())

  // Quan hệ
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

enum MessageType {
  TEXT
  IMAGE
  PRODUCT
}

model Address {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  name  String? // Tên người nhận
  phone String? // SĐT người nhận

  // Địa chỉ chi tiết
  specificAddress String? // Số nhà, tên đường (VD: 123 Nguyễn Trãi)
  fullAddress     String? // Địa chỉ hiển thị đầy đủ (VD: 123 Nguyễn Trãi, Thanh Xuân, Hà Nội)

  // Thông tin định danh GHN/Shipping
  provinceId Int?
  districtId Int?
  wardCode   String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- CORE: DANH MỤC & SẢN PHẨM ---

model Category {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  image        String? // Ảnh thumbnail của danh mục
  shops        Shop[]        @relation("ShopMainCategory")
  // Quan hệ đệ quy (Danh mục cha - con)
  // Ví dụ: Thời trang (Parent) -> Áo (Child) -> Áo phông (Child)
  parentId     String?
  parent       Category?     @relation("CategoryParent", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryParent")
  vouchers     Voucher[]
  // Sản phẩm thuộc danh mục này
  products     Product[]
  order        Int           @default(0)
  homeSections HomeSection[]

  // Cấu hình bộ lọc cho danh mục này
  // Lưu JSON mảng các key filter. VD: ["size", "material", "style"] cho quần áo
  // hoặc ["watts", "light_color"] cho đồ điện
  filterKeys Json? @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([name])
}

model ShopCategory {
  id        String    @id @default(uuid())
  name      String
  isActive  Boolean   @default(true)
  shopId    String
  shop      Shop?     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products  Product[] // Một danh mục shop có nhiều sản phẩm
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([shopId])
}

enum SectionType {
  HERO_BANNER // Carousel to
  FLASH_SALE // Khối Flash Sale
  CATEGORY_TWO_ROW // Khối 2 cột (Bán chạy / SP mới)
  SMART_PRODUCT // Khối Smart Product (Sắc đẹp, Điện tử...)
  RECOMMENDED // Khối gợi ý cuối trang
  BANNER_SINGLE // Banner quảng cáo đơn (nếu cần)
}

model HomePageSection {
  id       String      @id @default(uuid())
  title    String // Tên nội bộ để Admin quản lý (vd: "Khối Sắc Đẹp")
  type     SectionType // Loại hiển thị
  isActive Boolean     @default(true)
  order    Int         @default(0) // Số thứ tự hiển thị (1, 2, 3...)

  // Cấu hình JSON động. Admin sẽ chỉnh JSON này.
  // Ví dụ Smart Product: { "title": "SẮC ĐẸP", "emoji": "💄", "query": "SẮC ĐẸP", "headerColor": "text-rose-500" }
  config Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductStatus {
  DRAFT // Bản nháp (Seller chưa gửi duyệt)
  PENDING // Chờ duyệt (Mặc định khi Seller tạo xong)
  ACTIVE // Đã duyệt (Hiện lên sàn)
  REJECTED // Từ chối (Kèm lý do)
  HIDDEN // Seller tự ẩn
}

enum DiscountType {
  PERCENT
  AMOUNT
}

model Product {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String? @db.Text

  // Spec [0018]: mô tả ngắn structured 6 trường, hiện 6 dòng hoặc 3 dòng 2 cột
  // dưới tên SP. JSON shape: { brand, features, benefits, recipient, occasion, note }.
  // Field nullable nên SP cũ không break.
  shortDesc Json?

  // Giá và Tồn kho
  price         Decimal  @db.Decimal(15, 2)
  originalPrice Decimal? @db.Decimal(15, 2) // Giá gốc (để hiện gạch ngang giảm giá)
  stock         Int      @default(0)

  reviews      ProductReview[]
  reviewCount  Int             @default(0)
  systemTags   Json            @default("[]")
  // Hình ảnh (Lưu mảng JSON URL ảnh)
  images       Json
  status       ProductStatus   @default(PENDING) // Mặc định tạo xong là chờ duyệt ngay
  blogPosts    BlogPost[]
  // (Optional) Lý do từ chối nếu Admin reject
  rejectReason String?         @db.Text
  // --- TÍNH NĂNG DYNAMIC FILTER (QUAN TRỌNG) ---
  // Lưu các thuộc tính động. 
  attributes   Json?
  tags         String?         @db.Text
  brandId      Int?
  brandRel     Brand?          @relation(fields: [brandId], references: [id])

  vouchers Voucher[]

  flashSaleItems FlashSaleProduct[]

  crossSells  ProductCrossSell[] @relation("MainProduct")
  crossSoldIn ProductCrossSell[] @relation("RelatedProduct")

  shopCategoryId String?
  shopCategory   ShopCategory? @relation(fields: [shopCategoryId], references: [id])

  // 1 Product có nhiều nhóm phân loại (VD: Nhóm "Màu sắc", Nhóm "Size")
  options ProductOption[]

  // 1 Product có nhiều biến thể SKU (VD: "Xanh - S", "Đỏ - M")
  variants ProductVariant[]

  // wiki 0052: image search — trạng thái index vector vào Qdrant
  embedding ProductEmbedding?

  // Thống kê (Dùng để sort phổ biến, bán chạy)
  salesCount Int   @default(0)
  rating     Float @default(0)

  shopId   String?
  shop     Shop?   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  weight   Int     @default(200)
  // Quan hệ
  sellerId String?
  seller   User?   @relation(fields: [sellerId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  cartItems  CartItem[]
  orderItems OrderItem[]

  discountType      DiscountType?
  discountValue     Decimal?      @default(0) // Số % hoặc Số tiền
  discountStartDate DateTime?
  discountEndDate   DateTime?
  isDiscountActive  Boolean       @default(false)

  // wiki 0105 — affiliate sản phẩm. MẶC ĐỊNH TẮT: seller phải tự bật và tự đặt %,
  // vì hoa hồng TRỪ VÀO DOANH THU CỦA CHÍNH SELLER — không ai được bị trừ tiền
  // ngoài ý muốn. Trần % đọc từ SystemSetting `AFFILIATE_MAX_RATE`.
  // `affiliateRate` là tỉ lệ thập phân (0.0500 = 5%), không phải số phần trăm.
  affiliateEnabled Boolean         @default(false)
  affiliateRate    Decimal?        @db.Decimal(6, 4)
  affiliateLinks   AffiliateLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Index để tối ưu tìm kiếm và lọc
  @@index([name])
  @@index([categoryId, createdAt(sort: Desc)])
  @@index([categoryId, price])
  @@index([name, createdAt(sort: Desc)])
  @@index([sellerId, createdAt(sort: Desc)])
  @@index([slug])
  @@index([shopId])
  @@index([affiliateEnabled])
}

model Brand {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  logoUrl     String?
  description String? @db.Text
  status      String  @default("active") // 'active' | 'inactive'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[] // Relation to products
}

model ProductCrossSell {
  productId        String
  relatedProductId String

  product        Product @relation("MainProduct", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("RelatedProduct", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
  @@index([productId])
}

model ProductOption {
  id        String @id @default(uuid())
  productId String
  name      String // VD: "Màu sắc"
  position  Int // Thứ tự hiển thị (0, 1)

  values  ProductOptionValue[]
  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductOptionValue {
  id       String        @id @default(uuid())
  optionId String
  value    String // VD: "Xanh", "Đỏ"
  image    String?
  position Int           @default(0)
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId])
}

model ProductVariant {
  id             String             @id @default(uuid())
  productId      String
  price          Decimal
  originalPrice  Decimal?           @db.Decimal(15, 2)
  discountValue  Decimal?           @default(0)
  stock          Int
  sku            String? // Mã SKU riêng cho biến thể
  image          String? // Ảnh riêng cho biến thể (VD: Ảnh áo màu đỏ)
  flashSaleItems FlashSaleProduct[]
  // Lưu index kết hợp dưới dạng JSON hoặc String để map nhanh
  // VD: [0, 1] nghĩa là Option 1 (index 0) + Option 2 (index 1)
  tierIndex      String // Format: "0,0", "0,1" (Map với array values của FE gửi lên)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// --- SHOPPING CART ---

model Cart {
  id     String     @id @default(uuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]

  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  // Lưu tùy chọn sản phẩm trong giỏ (nếu có variant)
  // Ví dụ: { "color": "Red", "size": "M" }
  selectedOptions Json?

  @@unique([cartId, productId])
}

model AnalyticsLog {
  id        String   @id @default(uuid())
  userId    String? // Null nếu là Guest
  guestId   String? // Device ID
  eventType String // view, click, add_to_cart, purchase...
  targetId  String? // ProductID
  metadata  Json? // Chứa giá, nguồn traffic, từ khóa search...
  createdAt DateTime @default(now())

  // TỐI ƯU INDEX CHO BIG DATA QUERY
  @@index([userId])
  @@index([guestId])
  @@index([eventType, createdAt]) // Query theo loại event trong khoảng thời gian
  @@index([targetId]) // Để đếm view/sale của sản phẩm
}

// --- ORDER SYSTEM ---
model Order {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  status      OrderStatus @default(PENDING) // PENDING, PAID, SHIPPED, CANCELLED
  totalAmount Decimal
  shippingFee Decimal     @default(0)

  voucherId         String? // Có thể null nếu không dùng voucher (giữ để hiển thị; release dùng appliedVoucherIds)
  voucher           Voucher?        @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  appliedVoucherIds Json? // Wiki 0088 (#10/#10b): TẤT CẢ voucher id đã redeem cho checkout (shop+system+freeship) — để hoàn ĐỦ khi hủy (voucherId đơn không lưu hết → leak)
  shippingOrderCode String? // Mã đơn GHN (ví dụ: L8CC23)
  shippingProvider  String?         @default("GHN")
  productReviews    ProductReview[]
  shopReview        ShopReview?
  isReviewed        Boolean         @default(false)
  shopId            String?
  shop              Shop?           @relation(fields: [shopId], references: [id])

  districtId Int? // ID Quận/Huyện (GHN)
  wardCode   String? // Mã Phường/Xã (GHN)
  provinceId Int? // ID Tỉnh/Thành

  // Thông tin người nhận (cho Gift)
  recipientName    String?
  recipientPhone   String?
  recipientAddress String?
  message          String? // Lời chúc
  isGift           Boolean @default(false)

  paymentMethod String // MOMO, BANKING, COD
  paymentStatus String @default("UNPAID")

  // Wiki 0083: xu đã trừ cho đơn này (để hoàn khi hủy) + nhóm các đơn cùng 1 lần thanh toán (multi-shop checkout).
  coinUsed       Int     @default(0)
  paymentGroupId String?

  // G4 (wiki 0044/0045): IP của client lúc đặt đơn — dùng cho anti-farm referral
  // (so sánh IP của referrer.lastOrder vs IP của referee.thisOrder).
  clientIp String?

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([paymentGroupId])
}

model OrderItem {
  id                 String   @id @default(uuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id])
  productId          String? // 1. Đổi thành Optional (Thêm dấu ?)
  product            Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId          String? // Wiki 0083: biến thể đã mua — để hoàn tồn kho variant khi hủy đơn
  flashSaleProductId String? // Wiki 0088: link FlashSaleProduct để HOÀN sold khi hủy đơn (chống leak suất flash + griefing)

  quantity Int
  price    Decimal // Lưu giá tại thời điểm mua (đề phòng giá gốc đổi)
}

// Thêm vào schema.prisma

enum VoucherType {
  FIXED_AMOUNT // Giảm số tiền cố định (ví dụ: 50k)
  PERCENTAGE // Giảm theo % (ví dụ: 10%)
  FREESHIP // Spec [0018]: voucher freeship/giảm phí ship (loại riêng, áp dụng vào shipping fee không phải subtotal)
}

enum VoucherScope {
  GLOBAL // Voucher sàn
  SHOP // Voucher của Shop
  PRODUCT // Voucher cho sản phẩm cụ thể
  CATEGORY
}

enum DiscountStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  DEPLETED // Hết lượt dùng
}

model Voucher {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  description String?
  type        VoucherType
  scope       VoucherScope

  amount        Decimal  @db.Decimal(10, 2)
  maxDiscount   Decimal? @db.Decimal(10, 2)
  minOrderValue Decimal  @default(0) @db.Decimal(10, 2)

  usageLimit     Int
  usageCount     Int @default(0)
  userUsageLimit Int @default(1)

  homeSections HomeSection[]

  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)

  shopId String?
  shop   Shop?   @relation("ShopVouchers", fields: [shopId], references: [id], onDelete: Cascade)

  // Relation với User (Seller tạo voucher)
  sellerId String?
  seller   User?   @relation("SellerVouchers", fields: [sellerId], references: [id])

  // Relation với Product (Voucher áp dụng cho SP nào)
  products Product[]

  // Relation với Order (Voucher này đã dùng cho đơn nào)
  orders     Order[]
  categories Category[]

  // Tracking (Ai đã lưu voucher)
  userVouchers UserVoucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(0)

  @@index([shopId])
  @@index([startDate, endDate])
}

model UserVoucher {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) // Đã khớp với savedVouchers bên User

  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  isUsed Boolean   @default(false)
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, voucherId])
}

model HomeSection {
  id       String  @id @default(uuid())
  title    String
  type     String // "CATEGORY", "FLASH_SALE", "BANNER"
  order    Int     @default(0)
  isActive Boolean @default(true)

  // Cấu hình hiển thị (JSON)
  config Json?

  // Quan hệ
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  voucherId String?
  voucher   Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Banner {
  id          String   @id @default(uuid())
  location    String // 'HERO_MAIN', 'HERO_SUB', 'SIDEBAR_PROMO'
  src         String // URL ảnh
  alt         String?
  title       String?
  description String?
  ctaLabel    String? // Nút kêu gọi hành động
  ctaLink     String? // Link đích
  theme       String? // 'dark' | 'light'
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Quản lý các cấu hình menu phức tạp (Header Menu, Footer Link...)
model SystemConfig {
  key         String   @id // VD: 'HEADER_MEGA_MENU', 'HEADER_RECIPIENT_DATA', 'FOOTER_DATA'
  value       Json // Lưu cấu trúc mảng/object phức tạp
  description String?
  updatedAt   DateTime @updatedAt
}

model PayoutRequest {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  amount      Decimal      @db.Decimal(15, 2)
  status      PayoutStatus @default(PENDING)
  bankInfo    String // Format: "BankName - AccountNum - OwnerName"
  reason      String? // Lý do từ chối (nếu có)
  processedAt DateTime? // Ngày admin duyệt/từ chối
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([status])
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
}

model WalletTransaction {
  id          String                  @id @default(uuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id])
  amount      Decimal                 @db.Decimal(15, 2) // Số dương (+) là thu nhập, Số âm (-) là rút tiền
  type        WalletTransactionType
  status      WalletTransactionStatus @default(COMPLETED)
  referenceId String? // Order ID hoặc PayoutRequest ID
  description String?
  createdAt   DateTime                @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

enum WalletTransactionType {
  ORDER_INCOME // Tiền bán hàng cộng vào
  PAYOUT // Rút tiền về ngân hàng
  REFUND // Hoàn tiền cho khách
  FEE // Phí sàn (nếu có)
  AFFILIATE_COMMISSION // wiki 0105 — hoa hồng đã chốt sổ, cộng vào ví người tiếp thị
  AFFILIATE_FEE // wiki 0105 — hoa hồng trừ khỏi doanh thu seller (ghi riêng để seller thấy rõ trên sổ)
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum FlashSaleStatus {
  ENABLED
  DISABLED
}

enum FlashSaleProductStatus {
  PENDING
  APPROVED
  REJECTED
}

model FlashSaleSession {
  id        String          @id @default(uuid())
  startTime DateTime
  endTime   DateTime
  status    FlashSaleStatus @default(ENABLED)

  // Quan hệ 1-n
  products FlashSaleProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Index giúp query session theo thời gian nhanh hơn
  @@index([startTime, endTime])
}

model FlashSaleProduct {
  id String @id @default(uuid())

  // Quan hệ tới Session
  sessionId String
  session   FlashSaleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Quan hệ tới Product
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  originalPrice Decimal                @db.Decimal(15, 2)
  salePrice     Decimal                @db.Decimal(15, 2)
  stock         Int // Số lượng cam kết chạy Flash Sale
  sold          Int                    @default(0) // Số lượng đã bán
  status        FlashSaleProductStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, variantId])
  @@index([sessionId])
  @@index([productId])
}

model BlogCategory {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  parentId  String?
  parent    BlogCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  BlogCategory[] @relation("CategoryHierarchy")
  posts     BlogPost[]
  // Wiki 0068 C10: thứ tự hiển thị do admin kéo thả sắp xếp trong tab "Bài viết".
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([sortOrder])
}

model BlogPost {
  id         String        @id @default(uuid())
  title      String
  slug       String        @unique
  excerpt    String?       @db.Text
  content    String        @db.Text
  thumbnail  String?
  status     String        @default("DRAFT")
  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id])

  // --- SEO Fields ---
  metaTitle       String?
  metaDescription String?

  // FIX 1: Change String[] to String? for MySQL
  keywords String? @db.Text

  canonicalUrl String?
  ogImage      String?
  noIndex      Boolean @default(false)

  // --- Relations ---
  authorId        String
  author          User      @relation(fields: [authorId], references: [id])
  relatedProducts Product[]
  sortOrder       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// --------------------------------------
// CHARITY / DONATION
// Feature từ brief: "tạo quỹ từ thiện (trích % doanh thu)".
// Flow cơ bản:
//   1. Admin tạo CharityFund (quỹ).
//   2. User donate trực tiếp -> Donation với userId + fundId.
//   3. (Tương lai) Auto-trigger: khi Order DELIVERED, trích X% vào fund mặc định.
// --------------------------------------

enum CharityFundStatus {
  ACTIVE
  PAUSED
  CLOSED
}

model CharityFund {
  id            String                @id @default(uuid())
  name          String // "Quỹ hỗ trợ trẻ em vùng cao"
  slug          String                @unique
  description   String?               @db.Text
  image         String? // Cover image
  goalAmount    Decimal               @default(0) @db.Decimal(15, 2)
  // Snapshot tổng donation để query nhanh mà không scan table Donation.
  // Cập nhật bằng transaction mỗi lần donation mới.
  currentAmount Decimal               @default(0) @db.Decimal(15, 2)
  status        CharityFundStatus     @default(ACTIVE)
  // Spec [0018]: 1 quỹ chính (isPrimary=true) — nơi nhận trích ngầm 1% khi
  // không có campaign active. Chỉ 1 quỹ trên toàn sàn isPrimary tại 1 thời điểm
  // (admin enforce).
  isPrimary     Boolean               @default(false)
  donations     Donation[]
  campaigns     CharityCampaignFund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([slug])
  @@index([isPrimary])
}

// Spec [0018]: nhiều quỹ chạy song song dưới dạng "campaign". Mỗi campaign có
// thời gian active. Khi user checkout đơn hàng trong khoảng active, được CHỌN
// quỹ campaign để đóng góp; không có campaign -> mặc định quỹ primary.
model CharityCampaign {
  id          String                @id @default(uuid())
  name        String
  slug        String                @unique
  description String?               @db.Text
  banner      String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean               @default(true)
  funds       CharityCampaignFund[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([isActive, startDate, endDate])
}

// Bảng nối M-N giữa Campaign và Fund (1 campaign có thể chứa nhiều fund,
// 1 fund có thể tham gia nhiều campaign).
model CharityCampaignFund {
  campaignId String
  fundId     String
  campaign   CharityCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fund       CharityFund     @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@id([campaignId, fundId])
}

model Donation {
  id     String      @id @default(uuid())
  fundId String
  fund   CharityFund @relation(fields: [fundId], references: [id])

  // userId nullable để hỗ trợ donation ẩn danh (guest).
  // Nếu sau này add auto-trigger từ Order, dùng orderId để idempotent
  // (unique constraint tránh double-count khi order DELIVERED lặp event).
  userId  String?
  user    User?   @relation(fields: [userId], references: [id])
  orderId String? @unique

  amount      Decimal @db.Decimal(15, 2)
  note        String? @db.Text
  isAnonymous Boolean @default(false) // user chọn hiển thị "Anonymous" trong leaderboard

  createdAt DateTime @default(now())

  @@index([fundId, createdAt])
  @@index([userId])
}

// Newsletter subscribers — landing page footer signup form.
// Nguồn cài (sourceTag): "footer", "popup-welcome",... — phục vụ marketing
// theo dõi từng kênh. Email unique: cùng email không tạo bản ghi mới mà chỉ
// reactivate (set isActive=true). unsubscribedAt cho phép "soft delete" để
// vẫn giữ history khi user huỷ đăng ký.
model NewsletterSubscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  sourceTag      String?   @default("footer")
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([isActive, subscribedAt])
}

// Complaint / report — seller hoặc user gửi khiếu nại admin xử lý.
// Spec #65 trong feedback pass 2.
//   category:  enum string (shipping/product/finance/system) — string thay vì
//              Prisma enum để dễ thêm category mới mà không cần migration.
//   status:    open / processing / resolved / rejected.
//   relatedOrderId: optional link tới Order khi user đính kèm.
//   attachments: JSON array các URL ảnh/video bằng chứng (R2).
model Complaint {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  category       String // shipping | product | finance | system | other
  relatedOrderId String?
  title          String
  content        String  @db.Text
  attachments    Json? // string[]

  status     String    @default("open") // open | processing | resolved | rejected
  adminNote  String?   @db.Text
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// #11/#23/#35/#53 (wiki 0044/0045) — thông báo cá nhân.
// type: ORDER | PROMOTION | SYSTEM | CHAT | FRIEND
// link: deeplink để FE click chuyển trang (vd /user/purchase, /messages?role=admin)
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @default("SYSTEM")
  title     String    @db.VarChar(255)
  content   String    @db.Text
  link      String?
  image     String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

// wiki 0052: image search — metadata index trong MySQL, vector lưu trong Qdrant.
// Tách table riêng để query Product không phải JOIN nặng + dễ rebuild index.
enum EmbeddingStatus {
  PENDING // Chưa index
  INDEXED // Đã có vector trong Qdrant
  FAILED // Thử index nhưng lỗi (vd ảnh 404, CLIP service down)
  SKIPPED // SP không có ảnh → không index được
}

model ProductEmbedding {
  id        String  @id @default(uuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  status    EmbeddingStatus @default(PENDING)
  // SHA-256 của image bytes — nếu ảnh đổi mà hash giống cũ thì skip re-encode
  imageHash String?         @db.VarChar(64)
  model     String          @default("clip-ViT-B-32-multilingual-v1")
  // Lý do FAILED (vd "image fetch 404") để debug. Null khi INDEXED.
  errorMsg  String?         @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  indexedAt DateTime? // Set khi status -> INDEXED

  @@index([status, updatedAt])
}

// =====================================================================
// AFFILIATE SẢN PHẨM (wiki 0105)
//
// Chạy SONG SONG với hệ referral cũ (User.referredById) — KHÔNG thay thế.
// Referral gắn vào NGƯỜI (1-1 vĩnh viễn, thưởng 1 lần); affiliate gắn vào
// GIAO DỊCH (n-n, lặp vô hạn) nên phải có sổ cái riêng.
//
// Hai khoá idempotent quan trọng nhất của cả hệ nằm ở đây, đặt ở TẦNG DB
// chứ không dựa vào sự cẩn thận của code:
//   - AffiliateCommission.orderItemId @unique      → không trả hoa hồng 2 lần
//   - AffiliateSettlement @@unique([accountId, period]) → không chốt sổ 2 lần
// =====================================================================

enum AffiliateAccountStatus {
  PENDING // chờ admin duyệt
  APPROVED // được phép lấy link
  REJECTED // bị từ chối (được nộp lại)
  SUSPENDED // bị đình chỉ do gian lận
}

enum AffiliateCommissionStatus {
  PENDING // đơn đã đặt, chưa giao xong
  APPROVED // đơn giao xong — tạm tính, sàn đang giữ
  SETTLED // đã chốt sổ, tiền đã vào ví, rút được
  CANCELLED // đơn huỷ
  REJECTED // vi phạm (tự mua / trùng IP)
}

/// Một user = một tài khoản tiếp thị. Phải được admin duyệt mới lấy được link.
model AffiliateAccount {
  id           String                 @id @default(uuid())
  userId       String                 @unique
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  code         String                 @unique
  status       AffiliateAccountStatus @default(PENDING)
  channel      String?                @db.Text // kênh chia sẻ tự khai (FB/TikTok/Zalo…)
  note         String?                @db.Text
  rejectReason String?                @db.Text
  reviewedAt   DateTime?
  reviewedById String?

  // CHỈ đếm số lượng. TIỀN KHÔNG lưu ở đây — mọi con số tiền đều cộng từ
  // AffiliateCommission theo status. Số dư denormalize là nguồn drift kinh điển:
  // một nhánh code quên cập nhật là sổ lệch vĩnh viễn mà không ai biết.
  totalClicks Int @default(0)
  totalOrders Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links       AffiliateLink[]
  commissions AffiliateCommission[]
  settlements AffiliateSettlement[]

  @@index([status])
}

/// Một người tiếp thị × một sản phẩm = một link cố định (lấy lại vẫn ra link cũ).
model AffiliateLink {
  id        String           @id @default(uuid())
  code      String           @unique // mã ngắn nằm trong URL ?aff=<code>
  accountId String
  account   AffiliateAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopId    String? // chụp lại để lọc/báo cáo không phải join
  clicks    Int              @default(0)
  createdAt DateTime         @default(now())

  clickLogs   AffiliateClick[]
  commissions AffiliateCommission[]

  @@unique([accountId, productId])
  @@index([productId])
  @@index([shopId])
}

/// Nhật ký click — chống gian lận + báo cáo.
model AffiliateClick {
  id        String        @id @default(uuid())
  linkId    String
  link      AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  clientIp  String?
  userAgent String?       @db.Text
  viewerId  String? // userId nếu người bấm đã đăng nhập
  createdAt DateTime      @default(now())

  @@index([linkId, createdAt])
  @@index([clientIp, createdAt])
}

/// SỔ CÁI hoa hồng. Mỗi dòng hàng bán được sinh đúng một dòng ở đây.
/// `orderItemId @unique` đặt ở mức DÒNG HÀNG chứ không phải mức đơn, vì một đơn
/// có thể chứa nhiều món của nhiều người tiếp thị khác nhau.
model AffiliateCommission {
  id           String                    @id @default(uuid())
  accountId    String
  account      AffiliateAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  linkId       String
  link         AffiliateLink             @relation(fields: [linkId], references: [id], onDelete: Cascade)
  orderId      String
  orderItemId  String                    @unique
  productId    String
  shopId       String?
  sellerId     String?
  baseAmount   Decimal                   @db.Decimal(15, 2) // giá bán × số lượng lúc mua
  rate         Decimal                   @db.Decimal(6, 4) // % CHỤP LẠI lúc mua (seller đổi % sau không ảnh hưởng đơn cũ)
  amount       Decimal                   @db.Decimal(15, 2) // hoa hồng sau khi áp trần
  status       AffiliateCommissionStatus @default(PENDING)
  rejectReason String?
  deliveredAt  DateTime?
  settlementId String?
  settlement   AffiliateSettlement?      @relation(fields: [settlementId], references: [id])
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([accountId, status])
  @@index([orderId])
  @@index([status, deliveredAt])
}

/// Một kỳ chốt sổ của một người tiếp thị.
model AffiliateSettlement {
  id        String           @id @default(uuid())
  accountId String
  account   AffiliateAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  period    String // 'YYYY-MM' — kỳ được chốt
  amount    Decimal          @db.Decimal(15, 2)
  itemCount Int
  settledAt DateTime         @default(now())

  commissions AffiliateCommission[]

  @@unique([accountId, period])
  @@index([period])
}
